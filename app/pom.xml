<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example.urlshortener</groupId>
    <artifactId>agentic-engineering-url-shortener</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>app</artifactId>
  <name>app</name>

  <dependencies>
    <dependency><groupId>com.example.urlshortener</groupId><artifactId>url-shortener-api</artifactId></dependency>
    <dependency><groupId>com.example.urlshortener</groupId><artifactId>orchestration-api</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
    <dependency><groupId>net.logstash.logback</groupId><artifactId>logstash-logback-encoder</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>

    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
    <!--
      The JDK's HttpURLConnection cannot retry a streamed request body after a 401, which every
      auth-rejection test triggers. Apache HttpClient handles it, and TestRestTemplate picks it
      up automatically when it is on the classpath.
    -->
    <dependency><groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <finalName>agentic-url-shortener</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
        <configuration>
          <mainClass>com.example.urlshortener.app.Application</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
